// ── NEW MODELS ────────────────────────────────────────────────────────────────

model FailureMode {
  id              String   @id @default(cuid())
  name            String
  code            String?  @unique // RCM code, e.g., "FM-PMP-001"
  description     String?  @db.Text
  category        String   // mechanical, electrical, hydraulic, pneumatic, software, human_error, environmental
  severity        String   @default("medium") // low, medium, high, critical
  detectionMethod String?  // visual, vibration, temperature, oil_analysis, ndt
  iso14224Code    String?  // ISO 14224 taxonomy alignment
  isActive        Boolean  @default(true)
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdBy User   @relation("FailureModeCreatedBy", fields: [createdById], references: [id])
  records   FailureRecord[]

  @@index([category])
  @@index([severity])
  @@map("failure_modes")
}

model RcmAnalysis {
  id              String   @id @default(cuid())
  assetId         String
  name            String
  description     String?  @db.Text
  methodology     String   @default("full") // full, streamlined, focused
  status          String   @default("draft") // draft, in_progress, completed, approved
  analysisDate    DateTime?
  nextReviewDate  DateTime?
  resultSummary   String?  @db.Text // JSON: strategy recommendations, criticality results
  riskMatrix      String?  @db.Text // JSON: {likelihood: [{consequence: number, rating: number}]}
  approvedById    String?
  approvedAt      DateTime?
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  asset       Asset  @relation(fields: [assetId], references: [id])
  approvedBy  User?  @relation("RcmApprovedBy", fields: [approvedById], references: [id])
  createdBy  User   @relation("RcmCreatedBy", fields: [createdById], references: [id])

  @@index([assetId])
  @@index([status])
  @@map("rcm_analyses")
}

model WeibullAnalysis {
  id              String   @id @default(cuid())
  componentId     String
  name            String
  description     String?  @db.Text
  shape           Float?   // beta parameter
  scale           Float?   // eta parameter (characteristic life)
  location        Float?   // gamma parameter
  confidence      Float?   // confidence level (0-1)
  sampleSize      Int      @default(0)
  failureCount    Int      @default(0)
  timeRange       String?  @db.Text // JSON: {start, end, unit}
  resultSummary   String?  @db.Text // JSON: mtbf, reliability at t, b10 life, etc.
  dataPoints      String?  @db.Text // JSON: failure time data points
  analyzedAt      DateTime @default(now())
  analyzedById    String

  component ComponentRegistry @relation(fields: [componentId], references: [id], onDelete: Cascade)
  analyzedBy User              @relation("WeibullAnalyzedBy", fields: [analyzedById], references: [id])

  @@index([componentId])
  @@map("weibull_analyses")
}

model DowntimeAnalysis {
  id              String   @id @default(cuid())
  assetId         String
  periodStart     DateTime
  periodEnd       DateTime
  totalDowntime   Float    // hours
  plannedDowntime Float    // hours
  unplannedDowntime Float  // hours
  downtimeCost    Float?
  mtbf            Float?   // mean time between failures (hours)
  mttr            Float?   // mean time to repair (hours)
  availability    Float?   // percentage (0-100)
  reliability     Float?   // percentage (0-100)
  notes           String?  @db.Text
  createdById     String
  createdAt       DateTime @default(now())

  asset     Asset  @relation(fields: [assetId], references: [id])
  createdBy User   @relation("DowntimeCreatedBy", fields: [createdById], references: [id])

  @@index([assetId])
  @@index([periodStart])
  @@map("downtime_analyses")
}

model RemainingUsefulLife {
  id                String   @id @default(cuid())
  componentId       String
  currentHealth     Float    // 0-100 health score
  degradationRate   Float    // health points per day
  estimatedRul      Float?   // days until health reaches 0
  confidenceScore   Float    // 0-1
  lastUpdated       DateTime @default(now())
  analyzedById      String

  component ComponentRegistry @relation(fields: [componentId], references: [id], onDelete: Cascade)
  analyzedBy User              @relation("RulAnalyzedBy", fields: [analyzedById], references: [id])

  @@unique([componentId])
  @@index([estimatedRul])
  @@map("remaining_useful_life")
}

