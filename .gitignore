# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (main node_modules — installed by DEPLOY.sh if needed)
node_modules
node_modules/.prisma/client/

# Prisma prebuilt client (NEVER ignore — deployed to cPanel)
!prisma/prebuilt/

/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js — commit the full standalone output for cPanel (pre-built, no build needed)
.next/*
!.next/BUILD_ID
!.next/server/
!.next/static/
!.next/standalone/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log

# Skills directory
/skills/

# Database files
db/*.db
db/*.db-journal

# Upload / download directories
/upload/
/download/
/public/uploads/

# Source analysis
/source-analysis/

# System files
.accesslog
.config
.stats
.git-credentials
.zscripts/

# Environment variables (never commit)
.env
.env.local
.env.production
.github-token
