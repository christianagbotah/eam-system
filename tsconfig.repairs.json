{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "noEmit": true
  },
  "include": [
    "next-env.d.ts",
    "src/app/api/repairs/**/*.ts",
    "src/app/api/work-orders/**/*.ts",
    "src/components/repairs/**/*.ts",
    "src/components/repairs/**/*.tsx",
    "src/services/repairPlanning.service.ts",
    "src/services/workExecution.service.ts",
    "src/services/workOrderExecutionState.service.ts",
    "src/services/repairsReportXlsx.service.ts",
    "src/lib/repair-*.ts",
    "src/lib/work-order*.ts",
    "src/lib/plant-scope.ts",
    "scripts/seed-repairs-uat.ts",
    "e2e/repairs/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "mini-services",
    "skills",
    "source-analysis",
    "examples"
  ]
}
