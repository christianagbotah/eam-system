# ============================================================================
# iAssetsPro EAM Platform — Environment Configuration
# ============================================================================
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env to version control.
# ============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database (MariaDB / MySQL)
# ---------------------------------------------------------------------------
DATABASE_URL=mysql://eam:your_password@localhost:3306/iassetspro
# For Prisma direct (non-pooled):
# DATABASE_URL_DIRECT=mysql://eam:your_password@localhost:3306/iassetspro

# ---------------------------------------------------------------------------
# Redis — Caching, Sessions, BullMQ Job Queues
# ---------------------------------------------------------------------------
# When set, the platform uses real Redis for caching, pub/sub, and job queues.
# When omitted, the platform falls back to in-memory implementations (dev only).
REDIS_URL=redis://localhost:6379
# Optional: Redis key prefix for multi-app environments
# REDIS_KEY_PREFIX=iassetspro:

# ---------------------------------------------------------------------------
# Authentication & Security
# ---------------------------------------------------------------------------
# JWT secret for API session tokens (min 32 characters)
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars
# NextAuth.js secret (used if NextAuth is enabled)
NEXTAUTH_SECRET=change-me-another-random-secret
NEXTAUTH_URL=http://localhost:3000
# Password pepper (additional layer for password hashing)
# AUTH_PEPPER=your-optional-password-pepper

# ---------------------------------------------------------------------------
# Encryption — Sensitive field encryption at rest
# ---------------------------------------------------------------------------
ENCRYPTION_KEY=change-me-32-byte-encryption-key-0000

# ---------------------------------------------------------------------------
# SMTP — Email Notifications (optional)
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@iassetspro.com
SMTP_FROM_NAME=iAssetsPro

# ---------------------------------------------------------------------------
# File Upload
# ---------------------------------------------------------------------------
# Max upload size in bytes (default: 10MB)
MAX_UPLOAD_SIZE=10485760
# Upload directory (relative to project root)
UPLOAD_DIR=public/uploads

# ---------------------------------------------------------------------------
# Session Management
# ---------------------------------------------------------------------------
# Session TTL in seconds (default: 24 hours)
SESSION_TTL=86400
# Max sessions per user (default: 5)
MAX_SESSIONS_PER_USER=5

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
# Log level: debug, info, warn, error, fatal
LOG_LEVEL=info
# Enable OpenTelemetry tracing
# OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Prometheus metrics port (set to enable)
# PROMETHEUS_PORT=9090

# ---------------------------------------------------------------------------
# Industrial Connectivity (MQTT, OPC-UA, Modbus)
# ---------------------------------------------------------------------------
# MQTT Broker
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
# OPC-UA Server
# OPCUA_ENDPOINT=opc.tcp://localhost:4840
# Modbus TCP
# MODBUS_HOST=localhost
# MODBUS_PORT=502

# ---------------------------------------------------------------------------
# BullMQ Job Queue (optional overrides)
# ---------------------------------------------------------------------------
# Default concurrency per worker (default: 5)
BULLMQ_CONCURRENCY=5
# Job retention: completed jobs to keep (default: 200)
BULLMQ_REMOVE_ON_COMPLETE=200
# Job retention: failed jobs to keep (default: 100)
BULLMQ_REMOVE_ON_FAIL=100

# ---------------------------------------------------------------------------
# Historian / Time Series
# ---------------------------------------------------------------------------
# Downsampling intervals in seconds
# HISTORIAN_RAW_TTL=2592000        # 30 days
# HISTORIAN_1M_TTL=7776000         # 90 days
# HISTORIAN_5M_TTL=31536000        # 365 days
# HISTORIAN_1H_TTL=63072000        # 2 years
# HISTORIAN_1D_TTL=null            # Keep forever

# ---------------------------------------------------------------------------
# External AI Services (z-ai-web-dev-sdk)
# ---------------------------------------------------------------------------
# Z_AI_API_KEY=your-api-key-here

# ---------------------------------------------------------------------------
# Cron / Scheduled Tasks (Escalation, PM Checks)
# ---------------------------------------------------------------------------
# Secret header for cron-triggered endpoints
# CRON_SECRET=your-cron-secret-here
