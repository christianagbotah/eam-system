# ============================================================================
# iAssetsPro EAM Platform — Environment Variables Template
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================================

# ---- General Application Settings -----------------------------------------
# The port the Next.js app listens on (inside container / host)
APP_PORT=3000

# The public-facing URL of the application (used by NextAuth, email links, etc.)
NEXTAUTH_URL=http://localhost:3000

# Node environment — always "production" for Docker deployments
NODE_ENV=production

# ---- Database (MariaDB / MySQL) -------------------------------------------
# Connection string for Prisma. For Docker Compose with the included MariaDB:
DATABASE_URL=mysql://eam:eampassword@mariadb:3306/iassetspro
# For external database, use: mysql://user:pass@hostname:3306/dbname

# Database name (used by Docker Compose MariaDB init)
DB_NAME=iassetspro
DB_USER=eam
DB_PASSWORD=eampassword
DB_ROOT_PASSWORD=rootpassword
DB_PORT=3306

# ---- Redis -----------------------------------------------------------------
# Redis connection URL. For Docker Compose with the included Redis:
REDIS_URL=redis://redis:6379
REDIS_PORT=6379
# Maximum memory Redis can use (e.g. 256mb, 512mb, 1gb)
REDIS_MAXMEMORY=256mb

# ---- Authentication & Security --------------------------------------------
# Secret used to sign JWT tokens — MUST be a long random string (32+ chars)
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARS_LONG

# Secret used by NextAuth.js — MUST be a long random string (32+ chars)
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARS_LONG

# Token expiration times
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# ---- SMTP / Email Settings -------------------------------------------------
# Used for email notifications, password resets, and system alerts
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=iAssetsPro EAM
SMTP_FROM_EMAIL=noreply@example.com

# ---- MQTT Broker Settings --------------------------------------------------
# MQTT broker for IoT device communication and telemetry ingestion
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=iassetspro-eam
# Topic prefix for subscribing to device telemetry
MQTT_TOPIC_PREFIX=eam/
# QoS level for MQTT subscriptions (0, 1, or 2)
MQTT_QOS=1

# ---- OPC-UA Settings -------------------------------------------------------
# OPC-UA server endpoint for industrial data acquisition
OPCUA_ENDPOINT_URL=opc.tcp://localhost:4840
OPCUA_SECURITY_MODE=None
OPCUA_SECURITY_POLICY=None
OPCUA_USERNAME=
OPCUA_PASSWORD=

# ---- S3 / Object Storage ---------------------------------------------------
# Used for file attachments, 3D model storage, and document management
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=iassetspro
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Force path-style addressing (needed for MinIO and some S3-compatible storages)
S3_FORCE_PATH_STYLE=true

# ---- File Upload Settings --------------------------------------------------
# Maximum file upload size in bytes (default 50MB)
MAX_FILE_UPLOAD_SIZE=52428800
# Allowed file extensions (comma-separated, empty = allow all)
ALLOWED_FILE_EXTENSIONS=.pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png,.gif,.zip,.step,.stl,.glb,.gltf

# ---- Application Logging ---------------------------------------------------
# Log level: debug, info, warn, error, fatal
LOG_LEVEL=info
# Enable slow query logging (logs DB queries slower than threshold)
SLOW_QUERY_THRESHOLD_MS=5000

# ---- Next.js Configuration -------------------------------------------------
# Disable telemetry
NEXT_TELEMETRY_DISABLED=1
